# ==========================================
# FARMCONNECTPRICES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to .env in local development.
# DO NOT COMMIT ACTUAL SECRET KEYS OR PRIVATE CREDENTIALS TO GIT.

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8080

# Firebase Web App Configuration (Public Client Config)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_PLACEHOLDER
VITE_FIREBASE_AUTH_DOMAIN=farmconnectprices-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=farmconnectprices-dev
VITE_FIREBASE_STORAGE_BUCKET=farmconnectprices-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase Emulator Settings (Local Development)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIREBASE_EMULATOR_PORT=8081

# Optional Hero Video Configuration
# Leave empty to use the production CSS gradient ambient background
VITE_HERO_VIDEO_URL=

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
