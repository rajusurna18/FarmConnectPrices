
# ==============================================================================
# FarmConnectPrices Frontend Environment Variables Template
# ==============================================================================
# All VITE_* variables are embedded at build time into static JavaScript assets.
# NEVER place private secrets or server-side private keys in this file.

# ------------------------------------------------------------------------------
# 1. API Configuration
# ------------------------------------------------------------------------------
# Development: http://localhost:8080
# Production:  https://api.farmconnectprices.com (or your cloud backend URL)
VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. Firebase Web SDK Configuration (Firebase Console -> Project Settings)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=farmconnectprices
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 3. Firebase Emulator (Optional for local development; false in production)
# ------------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIREBASE_EMULATOR_PORT=8081

