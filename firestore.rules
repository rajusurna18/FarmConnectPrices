rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection: Authenticated users can read and write only their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow initial document creation during registration
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role == "USER"
                    && request.resource.data.status == "ACTIVE";

      // Allow profile updates, preventing client modification of protected fields
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Farmer Profiles Collection: Authenticated users access only their own profile
    match /farmerProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Mediator / Buyer Profiles Collection: Authenticated users access only their own profile
    match /mediatorBuyerProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Customer Profiles Collection: Authenticated users access only their own profile
    match /customerProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Farms Collection: Authenticated users access only their own farms
    match /farms/{farmId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
    }

    // Farm Crops Collection: Authenticated users access only their own farm-crop relationships
    match /farmCrops/{farmCropId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
    }

    // Master Reference Crops Collection: Read-only for authenticated users
    match /crops/{cropId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Master Reference Locations Collection: Read-only for authenticated users
    match /locations/{locationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Master Reference Markets Collection: Read-only for authenticated users
    match /markets/{marketId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Master Reference Market Crops Collection: Read-only for authenticated users
    match /marketCrops/{marketCropId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Master Reference Market Prices Collection: Mediated by Spring Boot Backend / Firebase Admin SDK
    match /marketPrices/{priceId} {
      allow read, write: if false;
    }

    // Default Deny: All other collections remain completely inaccessible until explicit rules are added
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

